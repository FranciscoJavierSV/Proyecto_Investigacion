# MongoDB local, remota o accesible mediante cualquier servidor/tunel.
# Usa una URI alcanzable desde los contenedores.
MONGO_URI=mongodb://usuario:password@servidor:27017/baseDR
CLIENTDB=baseDR
DB_NAME=baseDR

# Puertos publicados en el host
COMPARISON_PORT=4000
RESEARCH_PORT=4001
CONSUMER_METRICS_PORT=9464
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Kafka interno de Docker
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=data
KAFKA_GROUP_ID=data-collector
KAFKA_LOG_MESSAGE_MAX_BYTES=100485760
KAFKA_REPLICA_FETCH_MAX_BYTES=100485760

# Generacion e ingesta
SEED_N=100000
SEED_BATCH=5000
SEED_WORKERS=4
CONSUMER_BATCH_SIZE=5000
DATA_DIR=/app/data
METRICS_PORT=9464
PORT=4000
NODE_ENV=production
